# Попадает в каждый <loc> в sitemap.xml и в robots.txt.
# На продакшен-сборке обязательно боевой домен по https, иначе Google Search
# Console отклонит карту: все URL должны быть на том же хосте, что и сама карта.
# Прод: NUXT_PUBLIC_SITE_URL=https://chempha.com
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Должен быть доступен во время сборки: sitemap.xml пререндерится на билде,
# и без Strapi в карту не попадут товары, новости и категории.
STRAPI_URL=http://localhost:1337
